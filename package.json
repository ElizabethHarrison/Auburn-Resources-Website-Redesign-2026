{
  "name": "auburn-web",
  "private": true,
  "type": "module",
  "description": "Website for Auburn Resources Limited (auburnresources.com.au)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=10.33.0"
  },
  "scripts": {
    "dev": "pnpm --filter @auburn/site dev",
    "studio": "pnpm --filter @auburn/studio dev",
    "build": "pnpm --filter @auburn/site build",
    "build:preview": "pnpm --filter @auburn/site build:preview",
    "build:sanity-export": "pnpm --filter @auburn/site build:sanity-export && pnpm --filter @auburn/site build:sanity-export:preview",
    "serve": "pnpm --filter @auburn/site serve",
    "serve:production": "node tests/static-server.mjs apps/site/dist 4600",
    "serve:preview": "node tests/static-server.mjs apps/site/dist-preview 4601",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "typegen": "pnpm --filter @auburn/studio typegen",
    "typegen:check": "node scripts/check-typegen.mjs",
    "content:export": "pnpm --filter @auburn/site content:export",
    "budget": "node scripts/check-js-budget.mjs apps/site/dist && node scripts/check-js-budget.mjs apps/site/dist-sanity",
    "readiness": "node scripts/readiness-report.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm typegen:check && pnpm build && pnpm build:preview && pnpm build:sanity-export && pnpm readiness && pnpm budget && pnpm test:e2e"
  },
  "devDependencies": {
    "@auburn/security-headers": "workspace:*",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
