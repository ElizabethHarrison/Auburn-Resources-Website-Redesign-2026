---
/** Primitives: the smallest building blocks. None depends on content status. */
import ArrowLink from '~/components/primitives/ArrowLink.astro';
import Button from '~/components/primitives/Button.astro';
import Container from '~/components/primitives/Container.astro';
import DateMono from '~/components/primitives/DateMono.astro';
import Grid from '~/components/primitives/Grid.astro';
import Icon, { type IconName } from '~/components/primitives/Icon.astro';
import MonoLabel from '~/components/primitives/MonoLabel.astro';
import Rule from '~/components/primitives/Rule.astro';
import SheetRef from '~/components/primitives/SheetRef.astro';
import Tag from '~/components/primitives/Tag.astro';
import VisuallyHidden from '~/components/primitives/VisuallyHidden.astro';
import CatalogueSection from '../CatalogueSection.astro';
import Specimen from '../Specimen.astro';

const icons: IconName[] = ['arrow-right', 'arrow-down', 'plus', 'minus', 'north-arrow', 'file'];
---

<CatalogueSection id="primitives" number="B" title="Primitives">
  <Specimen
    name="Button"
    notes="Links when given an href, real buttons otherwise. Square, 16 × 22 px padding, at least 44 px tall. Hover underlines; no colour blocks."
  >
    <div class="row">
      <Button href="#primitives">Explore the projects</Button>
      <Button href="#primitives" variant="secondary">
        Investor updates
      </Button>
      <Button>Button element</Button>
    </div>
  </Specimen>

  <Specimen
    name="Button on Survey Blue"
    ground="dark"
    notes="Light and outline-light variants for the CTA band and footer. Paper focus ring."
  >
    <div class="row">
      <Button href="#primitives" variant="light">
        Get investor updates
      </Button>
      <Button href="#primitives" variant="outline-light">
        Discuss a partnership
      </Button>
    </div>
  </Specimen>

  <Specimen name="ArrowLink" notes="Standalone link with a decorative arrow; underline on hover.">
    <div class="row">
      <ArrowLink href="#primitives">Read the dossier</ArrowLink>
      <ArrowLink href="#primitives">View the full register</ArrowLink>
    </div>
  </Specimen>

  <Specimen
    name="Tag"
    notes="Commodity tags use copper (Auburn's ground) with copper-text lettering; state and stage tags use Survey Blue."
  >
    <div class="row">
      <Tag variant="commodity">Zinc</Tag>
      <Tag variant="commodity">Copper</Tag>
      <Tag>QLD</Tag>
      <Tag>Drill-ready</Tag>
    </div>
  </Specimen>

  <Specimen
    name="MonoLabel"
    notes="Tones: label (Cyanotype), meta (muted), ink (Survey Blue), copper (copper-text). Sizes 10.5–13 px."
  >
    <div class="stack">
      <MonoLabel>Label · Cyanotype · 12 px</MonoLabel>
      <MonoLabel tone="meta" size="xs">
        Meta · muted · 10.5 px
      </MonoLabel>
      <MonoLabel tone="ink" size="lg">
        Ink · Survey Blue · 13 px
      </MonoLabel>
      <MonoLabel tone="copper" size="sm">
        Copper text · 11 px
      </MonoLabel>
    </div>
  </Specimen>

  <Specimen name="Rule" notes="Decorative by default; semantic variant renders <hr>.">
    <div class="stack">
      <Rule />
      <Rule variant="secondary" />
      <Rule semantic />
    </div>
  </Specimen>

  <Specimen
    name="Container and Grid"
    notes="Container: page width with 16–64 px gutters. Grid layouts stack below 48rem and gain columns at 48rem and 64rem."
  >
    <Container>
      <div class="stack">
        <MonoLabel>Grid · thirds (1 → 2 → 3)</MonoLabel>
        <Grid layout="thirds">
          <div class="cell">1</div>
          <div class="cell">2</div>
          <div class="cell">3</div>
        </Grid>
        <MonoLabel>Grid · quarters (1 → 2 → 4)</MonoLabel>
        <Grid layout="quarters">
          <div class="cell">1</div>
          <div class="cell">2</div>
          <div class="cell">3</div>
          <div class="cell">4</div>
        </Grid>
        <MonoLabel>Grid · sidebar (1 → 4 | 8)</MonoLabel>
        <Grid layout="sidebar">
          <div class="cell">Aside</div>
          <div class="cell">Main</div>
        </Grid>
      </div>
    </Container>
  </Specimen>

  <Specimen
    name="DateMono"
    notes="DD MMM YYYY in mono inside a <time> element. Fixed three-letter months (en-AU would give “Sept”)."
  >
    <p>
      <DateMono date="2026-09-29" />
    </p>
  </Specimen>

  <Specimen name="SheetRef" notes="Sheet number and page name, used in the header and breadcrumb.">
    <div class="stack">
      <SheetRef sheet="00" label="Home" />
      <SheetRef sheet="02.1" label="Nicholson" />
      <SheetRef sheet="03" />
    </div>
  </Specimen>

  <Specimen
    name="VisuallyHidden"
    notes="The text after the arrow is hidden visually but read by screen readers."
  >
    <p>
      Visible text →{' '}
      <VisuallyHidden>This sentence is for assistive technology only.</VisuallyHidden>
    </p>
  </Specimen>

  <Specimen
    name="Icon"
    notes="Small in-house set; 1.5 px stroke, square caps. Decorative unless given a label."
  >
    <ul class="icons" role="list">
      {icons.map((name) => (
        <li>
          <span class="icons__glyph">
            <Icon name={name} />
          </span>
          <span class="icons__name">{name}</span>
        </li>
      ))}
    </ul>
  </Specimen>
</CatalogueSection>

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cell {
    padding: var(--space-2);
    border: var(--rule-secondary);
    background-color: var(--water);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }

  .icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .icons li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .icons__glyph {
    color: var(--ink-survey);
    font-size: var(--space-4);
  }

  .icons__name {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }
</style>
