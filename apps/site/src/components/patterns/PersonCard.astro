---
/**
 * Leadership card (docs/SITEMAP.md 01.1): portrait, name, role, qualifications, bio. The page decides
 * who appears (`isPersonListable`); inside the card, unapproved facts and bios are hidden in production
 * and shown as placeholders or with status in preview. No portrait is ever faked: without an approved
 * image the card simply has no image.
 */
import type { ContentMode } from '~/lib/facts';
import { isRenderable, resolve } from '~/lib/facts';
import { renderMode } from '~/lib/config';
import type { Person } from '~/lib/content/types';
import type { SourceIndex } from '~/lib/content/sources';
import FactValue from './FactValue.astro';
import Placeholder from './Placeholder.astro';
import SourceLine from './SourceLine.astro';

export interface Props {
  person: Person;
  headingLevel?: 2 | 3 | 4;
  sources?: SourceIndex | undefined;
  mode?: ContentMode | undefined;
}

const { person, headingLevel = 3, sources } = Astro.props;
const mode = renderMode(Astro.props.mode);
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const portrait = resolve(person.portrait, mode);
const bio = resolve(person.bio, mode);
---

<article class:list={['person-card', { 'person-card--with-portrait': portrait.kind !== 'hidden' }]}>
  {portrait.kind === 'value' && (
    <img
      class="person-card__portrait"
      src={portrait.item.value}
      alt={`Portrait of ${person.name}`}
      loading="lazy"
      decoding="async"
    />
  )}
  {portrait.kind === 'placeholder' && (
    <div class="person-card__portrait person-card__portrait--missing">
      <Placeholder brief={portrait.brief} field="Portrait" mode={mode} />
    </div>
  )}
  <div class="person-card__body">
    <Heading class="person-card__name">{person.name}</Heading>
    {isRenderable(person.role, mode) && (
      <p class="person-card__role">
        <FactValue fact={person.role} field="Role" mode={mode} />
      </p>
    )}
    {isRenderable(person.qualifications, mode) && (
      <p class="person-card__qualifications">
        <FactValue fact={person.qualifications} field="Qualifications" mode={mode} />
      </p>
    )}
    {bio.kind === 'value' && (
      <div class="person-card__bio">
        <p>{bio.item.text}</p>
        <SourceLine item={bio.item} sources={sources} mode={mode} />
      </div>
    )}
    {bio.kind === 'placeholder' && <Placeholder brief={bio.brief} field="Bio" mode={mode} />}
  </div>
</article>

<style>
  .person-card {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--rule);
  }

  /* Two columns only when there is a portrait (or, in preview, its placeholder). */
  @media (min-width: 48rem) {
    .person-card--with-portrait {
      grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr);
      gap: var(--grid-gap);
    }
  }

  .person-card__portrait {
    width: 100%;
    max-width: 14rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: var(--rule);
  }

  .person-card__portrait--missing {
    display: flex;
    align-items: flex-end;
    border-style: dashed;
    border-color: var(--placeholder-border);
  }

  .person-card__portrait--missing :global(.placeholder) {
    width: 100%;
    border: 0;
  }

  .person-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .person-card__name {
    font-size: var(--text-h3);
  }

  .person-card__role {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-mono-lg);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .person-card__qualifications {
    color: var(--color-meta);
    font-size: var(--text-small);
  }

  .person-card__bio {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-1);
  }
</style>
