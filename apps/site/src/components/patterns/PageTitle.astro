---
/**
 * Title block for inner pages (docs/DESIGN-DIRECTION.md): breadcrumb (carrying the sheet reference
 * below 1440 px), the page H1, and an optional introduction in the default slot. The home page uses its
 * own hero instead.
 */
import type { SheetNumber } from '~/lib/content/types';
import type { BreadcrumbItem } from '~/lib/seo';
import Breadcrumb from './Breadcrumb.astro';

export interface Props {
  heading: string;
  breadcrumbs: readonly BreadcrumbItem[];
  sheet?: SheetNumber | undefined;
  sheetLabel?: string | undefined;
  /** Always 1 on real pages; the catalogue shows it as 2 to keep its own outline valid. */
  level?: 1 | 2;
}

const { heading, breadcrumbs, sheet, sheetLabel, level = 1 } = Astro.props;
const Heading = `h${level}` as 'h1' | 'h2';
const hasIntro = Astro.slots.has('default');
---

<header class:list={['page-title', 'l-container', { 'page-title--intro': hasIntro }]}>
  <Breadcrumb items={breadcrumbs} sheet={sheet} sheetLabel={sheetLabel} />
  <Heading class="page-title__heading">{heading}</Heading>
  {hasIntro && (
    <div class="page-title__intro">
      <slot />
    </div>
  )}
</header>

<style>
  .page-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-block: var(--space-3); /* P5 (D-033): 24 px on phones */
  }

  @media (min-width: 64rem) {
    .page-title {
      padding-block: var(--space-4); /* 32 px */
    }

    /* P5: the introduction and actions sit beside the H1 (5/12 + 7/12), the breadcrumb across the top. */
    .page-title--intro {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--grid-gap);
      align-items: start;
    }

    .page-title--intro > :global(:first-child) {
      grid-column: 1 / -1;
    }

    .page-title--intro .page-title__intro {
      padding-top: var(--space-1);
    }
  }

  .page-title__heading {
    max-width: 20ch;
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .page-title__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: var(--measure);
    font-size: var(--text-lead);
  }
</style>
