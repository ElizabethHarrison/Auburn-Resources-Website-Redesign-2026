---
/**
 * Timeline (project module 03; company milestone timeline). An ordered list of dated events.
 *
 * Phase 2 renders it in sequence, not to scale. The sitemap asks for a to-scale timeline "only when all
 * items are dated"; that variant needs real dated data and is flagged in the design review.
 * An event without a renderable date is dropped in production (never half-shown).
 */
import type { ContentMode } from '~/lib/facts';
import { isRenderable } from '~/lib/facts';
import { renderMode } from '~/lib/config';
import type { FactDisplay } from '~/lib/format';
import FactValue from './FactValue.astro';

export interface TimelineItem {
  /** The event's date or year, as a Fact slot (`label` is the event title). */
  readonly when: FactDisplay;
  readonly detail?: string;
}

export interface Props {
  items: readonly TimelineItem[];
  /** Accessible name, e.g. "Exploration history". */
  label: string;
  mode?: ContentMode | undefined;
}

const { items, label } = Astro.props;
const mode = renderMode(Astro.props.mode);
const visible = items.filter((item) => isRenderable(item.when.slot, mode));
---

{visible.length > 0 && (
  <ol class="timeline" aria-label={label}>
    {visible.map((item) => (
      <li class="timeline__event">
        <span class="timeline__when">
          <FactValue fact={item.when.slot} format={item.when.format} field="Date" mode={mode} />
        </span>
        <span class="timeline__what">
          <span class="timeline__title">{item.when.label}</span>
          {item.detail && <span class="timeline__detail">{item.detail}</span>}
        </span>
      </li>
    ))}
  </ol>
)}

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: var(--rule);
  }

  .timeline__event {
    position: relative;
    display: grid;
    gap: var(--space-half);
    padding: 0 0 var(--space-3) var(--space-3);
  }

  /* Tick on the axis. */
  .timeline__event::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: var(--space-2);
    border-top: var(--rule);
  }

  .timeline__when {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-mono-lg);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }

  .timeline__what {
    display: flex;
    flex-direction: column;
    gap: var(--space-half);
  }

  .timeline__title {
    color: var(--ink-survey);
  }

  .timeline__detail {
    font-size: var(--text-small);
  }

  @media (min-width: 48rem) {
    .timeline__event {
      grid-template-columns: minmax(8rem, 1fr) minmax(0, 3fr);
      gap: var(--grid-gap);
    }
  }
</style>
