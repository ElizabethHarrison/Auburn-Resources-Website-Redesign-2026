---
/**
 * Heading for a page section: mono kicker (usually the numbered section, e.g. `02 Projects`), the
 * heading, and an optional section-level link. The heading's `id` lets the section use
 * aria-labelledby.
 */
import ArrowLink from '../primitives/ArrowLink.astro';

export interface Props {
  id: string;
  heading: string;
  kicker?: string | undefined;
  level?: 2 | 3;
  action?: { label: string; href: string } | undefined;
  /**
   * `bar` (default): the rule above, heading left and action right on wide screens. `margin`: no rule of
   * its own and always stacked, for a heading set in a margin column beside its body (PageBlock, D-033).
   */
  layout?: 'bar' | 'margin';
}

const { id, heading, kicker, level = 2, action, layout = 'bar' } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<div class:list={['section-heading', `section-heading--${layout}`]}>
  <div class="section-heading__text">
    {kicker && <p class="section-heading__kicker">{kicker}</p>}
    <Heading id={id} class="section-heading__title">
      {heading}
    </Heading>
  </div>
  {action && <ArrowLink href={action.href}>{action.label}</ArrowLink>}
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: var(--rule);
  }

  .section-heading--margin {
    padding-top: 0;
    border-top: 0;
  }

  @media (min-width: 64rem) {
    .section-heading--bar {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .section-heading__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .section-heading__kicker {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono-wide);
    text-transform: uppercase;
  }

  .section-heading__title {
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-display);
  }
</style>
