---
/** Page-width container with responsive gutters (64 px desktop → 16 px at 360 px). */
export interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav' | 'aside';
  /** Accessible name; only applied to landmark elements (`section`, `nav`, `aside`). */
  label?: string;
}

const { as: Element = 'div', label } = Astro.props;
const isLandmark = Element === 'section' || Element === 'nav' || Element === 'aside';
---

<Element class="l-container" aria-label={isLandmark ? label : undefined}>
  <slot />
</Element>
