---
/**
 * Home §7 — News: the latest two articles. No articles exist yet and none may be invented, so this
 * renders nothing in production and an INPUT NEEDED in preview until articles are published.
 */
import type { ContentMode } from '~/lib/facts';
import { resolve } from '~/lib/facts';
import type { Article } from '~/lib/content/types';
import { latestArticles } from '~/lib/content/visibility';
import Container from '~/components/primitives/Container.astro';
import FactValue from '~/components/patterns/FactValue.astro';
import Placeholder from '~/components/patterns/Placeholder.astro';
import SectionHeading from '~/components/patterns/SectionHeading.astro';

export interface Props {
  articles: readonly Article[];
  mode: ContentMode;
}

const { articles, mode } = Astro.props;
const latest = latestArticles(articles, mode, 2);
const visible = latest.length > 0 || mode === 'preview';
---

{visible && (
  <section class="news-module" aria-labelledby="home-news">
    <Container>
      <SectionHeading
        id="home-news"
        kicker="05 News"
        heading="News"
        action={latest.length > 0 ? { label: 'All news', href: '/news' } : undefined}
      />
      <div class="news-module__body">
        {latest.length > 0 ? (
          <ul class="news-module__list" role="list">
            {latest.map((article) => {
              const lead = resolve(article.lead, mode);
              return (
                <li class="news-module__item">
                  <p class="news-module__date">
                    <FactValue fact={article.date} field="Date" mode={mode} />
                  </p>
                  <h3 class="news-module__title">
                    <a href={`/news/${article.slug}`}>{article.title}</a>
                  </h3>
                  {lead.kind === 'value' && <p>{lead.item.text}</p>}
                </li>
              );
            })}
          </ul>
        ) : (
          <Placeholder
            brief="No news articles have been supplied; the module stays hidden in production until one is published"
            field="Latest news"
            mode={mode}
          />
        )}
      </div>
    </Container>
  </section>
)}

<style>
  .news-module {
    padding-block: var(--section-padding);
  }

  .news-module__body {
    margin-top: var(--space-5);
  }

  .news-module__list {
    display: grid;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .news-module__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .news-module__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-2);
    border-top: var(--rule-secondary);
  }

  .news-module__date {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    text-transform: uppercase;
  }

  .news-module__title {
    font-size: var(--text-h3);
  }
</style>
