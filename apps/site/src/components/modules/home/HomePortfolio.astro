---
/**
 * Home §4 — 02 Projects, "The portfolio, sheet by sheet": one sheet card per listable project. The list
 * comes from content (the verified project list is still open, Q-20); nothing renders when no project
 * is confirmed for this mode.
 */
import type { ContentMode } from '~/lib/facts';
import type { Project } from '~/lib/content/types';
import Container from '~/components/primitives/Container.astro';
import Grid from '~/components/primitives/Grid.astro';
import SectionHeading from '~/components/patterns/SectionHeading.astro';
import SheetCard from '~/components/patterns/SheetCard.astro';

import { toneClass, type Tone } from '~/lib/tones';

export interface Props {
  projects: readonly Project[];
  mode: ContentMode;
  /** Section ground (D-032): white by default; the page assigns bands. */
  tone?: Tone | undefined;
}

const { projects, mode, tone } = Astro.props;
---

{projects.length > 0 && (
  <section class:list={['home-section', toneClass(tone)]} aria-labelledby="home-portfolio">
    <Container>
      <SectionHeading
        id="home-portfolio"
        kicker="02 Projects"
        heading="The portfolio, sheet by sheet"
        action={{ label: 'All projects and the full map', href: '/projects' }}
      />
      <div class="home-section__body">
        <Grid as="ul" layout="thirds">
          {projects.map((project) => (
            <li>
              <SheetCard project={project} mode={mode} />
            </li>
          ))}
        </Grid>
      </div>
    </Container>
  </section>
)}

<style>
  .home-section {
    padding-block: var(--stack-padding); /* P2 (D-033): half above, half below; full in a band */
  }

  .home-section__body {
    margin-top: var(--space-3); /* P3: heading → body 24 px */
  }
</style>
