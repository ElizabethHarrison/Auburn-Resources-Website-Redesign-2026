---
/**
 * Home §5 — Why this ground: the under-cover thesis beside Fig. 2 (schematic cross-section with
 * legend). The thesis is geological interpretation (CP review) and its heading is a claim, so the whole
 * module needs both approved in production. Fig. 2 must be a CP-approved section (Q-33): it is never
 * drawn from the mockup.
 */
import type { ContentMode } from '~/lib/facts';
import { isModuleVisible, resolve } from '~/lib/facts';
import type { HomePageContent } from '~/lib/content/types';
import type { SourceIndex } from '~/lib/content/sources';
import { resolveFigure } from '~/lib/content/visibility';
import ArrowLink from '~/components/primitives/ArrowLink.astro';
import Container from '~/components/primitives/Container.astro';
import Figure from '~/components/patterns/Figure.astro';
import FigurePlaceholder from '~/components/patterns/FigurePlaceholder.astro';
import Placeholder from '~/components/patterns/Placeholder.astro';
import SourceLine from '~/components/patterns/SourceLine.astro';
import StatusDot from '~/components/patterns/StatusDot.astro';

import { toneClass, type Tone } from '~/lib/tones';

export interface Props {
  home: HomePageContent;
  sources: SourceIndex;
  mode: ContentMode;
  /** Section ground (D-032): white by default; the page assigns bands. */
  tone?: Tone | undefined;
}

const { home, sources, mode, tone } = Astro.props;
const visible = isModuleVisible([home.whyHeading, home.whyText], mode);
const heading = resolve(home.whyHeading, mode);
const text = resolve(home.whyText, mode);
const section = resolveFigure(home.crossSection, mode);
---

{visible && (
  <section class:list={['why', toneClass(tone)]} aria-labelledby="home-why">
    <Container>
      <div class="why__rule">
        <p class="why__kicker">Why this ground</p>
      </div>
      <div class:list={['why__grid', { 'why__grid--figure': section.kind !== 'hidden' }]}>
        <div class="why__text">
          <h2 id="home-why" class="why__heading">
            {heading.kind === 'value' ? heading.item.text : 'Why this ground'}
          </h2>
          {mode === 'preview' && heading.kind === 'value' && (
            <StatusDot status={heading.status} mode={mode} />
          )}
          {heading.kind === 'placeholder' && (
            <Placeholder brief={heading.brief} field="Heading" mode={mode} />
          )}
          {text.kind === 'value' && (
            <>
              <p>{text.item.text}</p>
              <SourceLine item={text.item} sources={sources} mode={mode} />
            </>
          )}
          {text.kind === 'placeholder' && (
            <Placeholder brief={text.brief} field="Thesis" mode={mode} />
          )}
          <ArrowLink href="/projects/how-we-explore">How we explore</ArrowLink>
        </div>

        {section.kind === 'figure' && (
          <div class="why__figure">
            <Figure
              number={2}
              caption={section.figure.caption}
              alt={section.figure.alt}
              image={{
                src: section.figure.src,
                width: section.figure.width,
                height: section.figure.height,
              }}
              source={section.figure.source}
              date={section.figure.date}
              longDescription={section.figure.longDescription}
              status={section.figure.status}
              mode={mode}
            />
          </div>
        )}
        {section.kind === 'placeholder' && (
          <div class="why__figure">
            <FigurePlaceholder
              number={2}
              title="Schematic cross-section: host sequence beneath cover."
              brief={section.brief}
              ratio="16 / 9"
              mode={mode}
            />
          </div>
        )}
      </div>
    </Container>
  </section>
)}

<style>
  .why {
    padding-block: var(--section-padding);
  }

  .why__rule {
    padding-top: var(--space-2);
    border-top: var(--rule);
  }

  .why__kicker {
    color: var(--color-label);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: var(--tracking-mono-wide);
    text-transform: uppercase;
  }

  .why__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }

  @media (min-width: 64rem) {
    .why__grid--figure {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--grid-gap);
    }
  }

  .why__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .why__heading {
    max-width: 20ch;
    font-size: var(--text-h2);
    letter-spacing: var(--tracking-display);
  }

  .why__figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
</style>
