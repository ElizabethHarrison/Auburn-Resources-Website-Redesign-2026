---
/**
 * Layout for the fixed pages (section pages, utility and legal pages): the site frame, the section
 * bar and breadcrumbs from the approved navigation (lib/pages.ts), and the title block. The page's
 * header actions go in the `actions` slot; its modules in the default slot.
 *
 * `section` + `href` place the page in its numbered section; utility and legal pages omit `section`
 * and have no sheet number (D-010).
 */
import type { ContentMode, NarrativeSlot } from '~/lib/facts';
import type { FrameData } from '~/lib/content/frame';
import type { NavLink, SectionId } from '~/lib/navigation';
import { sectionPageFrame, utilityBreadcrumbs } from '~/lib/pages';
import type { BreadcrumbItem, JsonLd } from '~/lib/seo';
import { projectUrl } from '~/lib/urls';
import PageHeader from '~/components/modules/page/PageHeader.astro';
import SiteLayout from './SiteLayout.astro';

export interface Props {
  /** The H1. */
  heading: string;
  /** `<title>` text when it should differ from the H1. */
  title?: string | undefined;
  description: string;
  frame: FrameData;
  href: string;
  section?: SectionId | undefined;
  /** Short name after the sheet number (default: the H1), e.g. "Announcement" for a document page. */
  sheetLabel?: string | undefined;
  /** Replaces the default breadcrumbs (e.g. a document inside a section page). */
  breadcrumbs?: readonly BreadcrumbItem[] | undefined;
  intro?: NarrativeSlot | undefined;
  jsonLd?: readonly JsonLd[] | undefined;
  noindex?: boolean | undefined;
  /** Canonical path for variants of another page (filtered listings, D-023). */
  canonicalPath?: string | undefined;
  mode: ContentMode;
}

const {
  heading,
  title,
  description,
  frame,
  href,
  section,
  intro,
  jsonLd,
  noindex,
  canonicalPath,
  mode,
} = Astro.props;
const sheetLabel = Astro.props.sheetLabel ?? heading;
const projectLinks: NavLink[] = frame.projects.map((project) => ({
  sheet: project.sheetNumber,
  label: project.name,
  href: projectUrl(project),
}));
const nav = section ? sectionPageFrame(section, href, projectLinks) : undefined;
const breadcrumbs =
  Astro.props.breadcrumbs ?? nav?.breadcrumbs ?? utilityBreadcrumbs(heading, href);
const hasActions = Astro.slots.has('actions');
---

<SiteLayout
  title={title ?? heading}
  description={description}
  frame={frame}
  sheet={nav?.sheet}
  sheetLabel={nav ? sheetLabel : undefined}
  currentSection={section}
  sectionBar={nav?.sectionBar}
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
  noindex={noindex}
  canonicalPath={canonicalPath}
>
  {hasActions ? (
    <PageHeader
      heading={heading}
      breadcrumbs={breadcrumbs}
      sheet={nav?.sheet}
      sheetLabel={nav ? sheetLabel : undefined}
      intro={intro}
      mode={mode}
    >
      <slot name="actions" />
    </PageHeader>
  ) : (
    <PageHeader
      heading={heading}
      breadcrumbs={breadcrumbs}
      sheet={nav?.sheet}
      sheetLabel={nav ? sheetLabel : undefined}
      intro={intro}
      mode={mode}
    />
  )}
  <div class="content-page">
    <slot />
  </div>
</SiteLayout>

<style>
  .content-page {
    padding-bottom: var(--space-5); /* P10 (D-033) */
  }

  /* A band that ends the page runs straight into the footer, with no white strip between (D-032). */
  .content-page:has(> :global(.tone-light:last-child), > :global(.tone-dark:last-child)) {
    padding-bottom: 0;
  }
</style>
