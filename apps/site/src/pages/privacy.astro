---
/**
 * Privacy (docs/SITEMAP.md, Legal template; no sheet number — D-010). The text is supplied by the company
 * (Q-24); nothing is drafted here.
 */
import ContentLayout from '~/layouts/ContentLayout.astro';
import { config } from '~/lib/config';
import { content } from '~/lib/content';
import { loadFrame } from '~/lib/content/frame';
import LegalText from '~/components/modules/legal/LegalText.astro';

const mode = config.contentMode;
const [frame, page] = await Promise.all([
  loadFrame(content, mode),
  content.getLegalPage('privacy'),
]);
---

<ContentLayout
  heading="Privacy"
  description="How Auburn Resources collects, uses and protects personal information, including email alert subscribers."
  frame={frame}
  href="/privacy"
  mode={mode}
>
  <LegalText page={page} mode={mode} />
</ContentLayout>
