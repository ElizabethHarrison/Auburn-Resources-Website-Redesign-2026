---
/**
 * Sheet 00 · Home (docs/WEBSITE-STRATEGY.md §5; docs/SITEMAP.md 00).
 *
 * Section order is approved and must not change (CLAUDE.md §9): header → hero → key facts →
 * 02 Projects → Why this ground → 03 Investors (the register) → News → Sustainability teaser → footer.
 * Every module decides its own visibility from content status; in production, modules without approved
 * content are omitted entirely.
 */
import SiteLayout from '~/layouts/SiteLayout.astro';
import { config } from '~/lib/config';
import { content } from '~/lib/content';
import { loadFrame } from '~/lib/content/frame';
import { createSourceIndex } from '~/lib/content/sources';
import { organizationJsonLd } from '~/lib/seo';
import HomeHero from '~/components/modules/home/HomeHero.astro';
import HomeKeyFacts from '~/components/modules/home/HomeKeyFacts.astro';
import HomeNews from '~/components/modules/home/HomeNews.astro';
import HomePortfolio from '~/components/modules/home/HomePortfolio.astro';
import HomeRegister from '~/components/modules/home/HomeRegister.astro';
import HomeSustainability from '~/components/modules/home/HomeSustainability.astro';
import HomeWhyThisGround from '~/components/modules/home/HomeWhyThisGround.astro';

const mode = config.contentMode;
const [frame, home, documents, articles] = await Promise.all([
  loadFrame(content, mode),
  content.getHomePage(),
  content.getDocuments(),
  content.getArticles(),
]);
const { settings } = frame;
const sources = createSourceIndex(documents);

const site = Astro.site;
if (!site) throw new Error('`site` must be set in astro.config.ts.');
const organization = organizationJsonLd(settings, mode, site);

// Deliberately claim-free: the description is published before any fact is approved.
const description =
  'Auburn Resources: the company, its exploration projects, investor information and announcements.';
---

<SiteLayout
  description={description}
  frame={frame}
  sheet="00"
  sheetLabel="Home"
  {...(organization ? { jsonLd: [organization] } : {})}
>
  <HomeHero home={home} keyFacts={settings.keyFacts} mode={mode} />
  <HomeKeyFacts keyFacts={settings.keyFacts} sources={sources} mode={mode} />
  <HomePortfolio projects={frame.projects} mode={mode} />
  <HomeWhyThisGround home={home} sources={sources} mode={mode} />
  <HomeRegister keyFacts={settings.keyFacts} documents={documents} sources={sources} mode={mode} />
  <HomeNews articles={articles} mode={mode} />
  <HomeSustainability home={home} mode={mode} />
</SiteLayout>
